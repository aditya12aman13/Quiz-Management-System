<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AddQuestion.aspx.cs" Inherits="AddQuestion" %>
<!DOCTYPE html><html><head runat="server"><title>Add Question</title><link href="site.css" rel="stylesheet" /></head><body><form id="form1" runat="server"><div class="navbar"><div class="logo">QUIZ SYSTEM</div><a class="link" href="AdminDashboard.aspx">Dashboard</a></div><div class="page"><div class="heading">Add Question</div><div class="card"><div class="grid"><div class="form-row"><label>Course</label><asp:DropDownList ID="DropDownList2" runat="server" CssClass="select" AutoPostBack="True" OnSelectedIndexChanged="DropDownList2_SelectedIndexChanged"/></div><div class="form-row"><label>Topic</label><asp:DropDownList ID="DropDownList1" runat="server" CssClass="select"/></div></div><div class="form-row"><label>Question</label><asp:TextBox ID="TextBox1" runat="server" TextMode="MultiLine" CssClass="textarea"/></div><div class="grid"><div class="form-row"><label>Option 1</label><asp:TextBox ID="TextBox2" runat="server" CssClass="input"/></div><div class="form-row"><label>Option 2</label><asp:TextBox ID="TextBox3" runat="server" CssClass="input"/></div><div class="form-row"><label>Option 3</label><asp:TextBox ID="TextBox4" runat="server" CssClass="input"/></div><div class="form-row"><label>Option 4</label><asp:TextBox ID="TextBox5" runat="server" CssClass="input"/></div><div class="form-row"><label>Correct Answer</label><asp:TextBox ID="TextBox6" runat="server" CssClass="input"/></div></div><asp:Button ID="Button1" runat="server" Text="Save Question" CssClass="button" OnClick="Button1_Click"/><asp:Label ID="Label1" runat="server" CssClass="message"/></div></div></form></body></html>